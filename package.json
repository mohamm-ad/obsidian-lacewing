{
  "name": "obsidian-lacewing",
  "version": "1.0.1",
  "description": "Control the transparency and always-on-top behavior of Obsidian windows on macOS.",
  "type": "module",
  "main": "main.js",
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0 <23"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:install": "pnpm build && node scripts/install-dev.mjs",
    "release:check": "pnpm check && node scripts/validate-release.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "macos",
    "opacity",
    "transparency",
    "always-on-top",
    "smart-fade",
    "window-management"
  ],
  "author": "Mohammad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamm-ad/obsidian-lacewing.git"
  },
  "bugs": {
    "url": "https://github.com/mohamm-ad/obsidian-lacewing/issues"
  },
  "homepage": "https://github.com/mohamm-ad/obsidian-lacewing#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@electron/remote": "^2.1.2",
    "@types/node": "^20.17.0",
    "electron": "39.2.6",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "prettier": "^3.6.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^2.1.9"
  }
}
